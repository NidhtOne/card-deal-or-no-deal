{
  "name": "deal-or-no-deal-cards",
  "version": "0.1.0",
  "private": true,
  "description": "《卡牌一掷千金》：经典 Deal or No Deal 玩法改编的本地自托管网页游戏（纯虚拟娱乐）",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/init-env.js && concurrently -k -n server,web -c blue,green \"npm run start:dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "node server/dist/main.js",
    "lint": "eslint \"server/src/**/*.ts\" \"web/src/**/*.{ts,tsx}\" \"web/vite.config.ts\" \"web/playwright.config.ts\" \"web/e2e/**/*.ts\" \"scripts/**/*.js\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,css,html,md}\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "typescript": "5.5.4",
    "esbuild": "^0.24.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.4.2"
  }
}
